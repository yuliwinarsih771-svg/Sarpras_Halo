{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operational user profile for SIPALAK lab members without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teknisi", "guru", "siswa", "pengguna"]
        },
        "unit": {
          "type": "string",
          "maxLength": 60
        },
        "idNumber": {
          "type": "string",
          "maxLength": 40
        },
        "bio": {
          "type": "string",
          "maxLength": 240
        },
        "active": {
          "type": "boolean"
        },
        "inviteId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9._\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "unit", "idNumber", "bio", "active", "createdAt", "updatedAt"]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Pre-registered user account invitation created by Admin for Google Sign-In provisioning.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9._\\-]*$"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teknisi", "guru", "siswa", "pengguna"]
        },
        "unit": {
          "type": "string",
          "maxLength": 60
        },
        "idNumber": {
          "type": "string",
          "maxLength": 40
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "bio": {
          "type": "string",
          "maxLength": 240
        },
        "active": {
          "type": "boolean"
        },
        "claimed": {
          "type": "boolean"
        },
        "claimedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "invitedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "displayName",
        "role",
        "unit",
        "idNumber",
        "phone",
        "bio",
        "active",
        "claimed",
        "claimedByUid",
        "invitedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII (email and phone) for a SIPALAK user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin role assignment document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Laboratory hardware and equipment inventory item.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["Komputer", "Monitor", "Printer", "Jaringan", "Proyektor", "Periferal", "Lainnya"]
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "condition": {
          "type": "string",
          "enum": ["Baik", "Perlu perawatan", "Rusak"]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fundingSource": {
          "type": "string",
          "maxLength": 80
        },
        "procurementYear": {
          "type": "number"
        },
        "nextMaintenanceDate": {
          "type": "string",
          "maxLength": 20
        },
        "labScope": {
          "type": "string",
          "enum": ["smkn1sambeng"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "name",
        "category",
        "brand",
        "condition",
        "location",
        "fundingSource",
        "procurementYear",
        "nextMaintenanceDate",
        "labScope",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Loan": {
      "title": "Loan",
      "description": "Asset borrowing and return transaction.",
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
