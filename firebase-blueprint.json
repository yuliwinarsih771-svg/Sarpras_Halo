      ]
    },
    "UsernameAuth": {
      "title": "UsernameAuth",
      "description": "Encrypted email envelope keyed by user password for username-based Firebase Authentication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "salt": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64
        },
        "iv": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64
        },
        "encryptedEmail": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "salt", "iv", "encryptedEmail", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Operational user profiles without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly isolated user PII (email, phone)."
    },
    "/user_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/UserInvite" },
      "description": "Admin-created pre-registered user accounts awaiting first Google Sign-In."
    },
    "/username_auth/{usernameKey}": {
      "schema": { "$ref": "#/entities/UsernameAuth" },
      "description": "Password-encrypted email envelopes enabling username-based login without exposing emails or storing passwords."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator registry."
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "Laboratory inventory assets."
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/Loan" },
      "description": "Asset borrowing and return requests."
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/LabSchedule" },
      "description": "Laboratory usage schedule reservations."
    },
    "/maintenances/{maintenanceId}": {
      "schema": { "$ref": "#/entities/Maintenance" },
      "description": "Asset maintenance and repair logs."
    },
    "/attendances/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Laboratory visitor attendance entries."
    }
  }
}
