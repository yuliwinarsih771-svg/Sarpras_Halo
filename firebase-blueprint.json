        "actionTaken",
        "technicianName",
        "maintenanceDate",
        "status",
        "resultingCondition",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Computer laboratory visitor and session attendance record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "checkInTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "checkOutTime": {
          "type": "string",
          "maxLength": 10
        },
        "visitorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "visitorRole": {
          "type": "string",
          "enum": ["Guru", "Siswa", "Teknisi", "Staf"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "workstation": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
